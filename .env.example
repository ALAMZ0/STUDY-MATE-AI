# ==============================================================================
# StudyMate AI - Environment Variables Reference
# Copy this file to .env for local development or configure these variables
# directly in your deployment platform (e.g., Render Dashboard -> Environment).
# ==============================================================================

# Required: Public live Gradio URL for Google Gemma 4 E2B Instruct running in your Kaggle notebook.
# Provided when executing demo.launch(share=True) in the Kaggle notebook.
# Example format: https://<session-id>.gradio.live
GEMMA_API_URL="https://your-kaggle-gradio-id.gradio.live"

# Optional: Port on which the full-stack web service listens.
# On Render, this is automatically injected by the platform. Defaults to 3000 if unset.
PORT=3000

# Optional: Node environment mode ("production" for deployed web service, "development" for local work).
NODE_ENV="production"
